source ~/.screenrc

# sets the current window's name
# sessionname denoUtils


# sessionname denoUtils

screen -t notebooks zsh -c 'cd  ../../; exec zsh'

screen -t denoUtils

# screen -t docker zsh -c 'cd ../docker_jupyter-ijavascript-utils; exec zsh'

screen -t scratchpad zsh -c 'cd ../../jupyterScratchpad; exec zsh'

# Prefills the prompt. The original stuff string has no trailing ^M (Enter).
screen -t lint
stuff "deno run lint:watch"

# Prefills the prompt. The original stuff string has no trailing ^M (Enter).
screen -t test
stuff "deno run test:watch"

# agent
screen -t agent

screen -t debug

screen -t ijsUtils zsh -c 'cd ../../_nodejs/jupyter-ijavascript-utils; exec zsh'

screen -t server 10 zsh -c 'cd ../../; exec zsh'
# Prefills the prompt. The original stuff string has no trailing ^M (Enter).
stuff "jupyter lab"

screen -t plantuml 11
# Prefills the prompt. The original stuff string has no trailing ^M (Enter).
stuff "plantuml -picoweb"

# screen -t codeserver 12
# Prefills the prompt. The original stuff string has no trailing ^M (Enter).
# stuff "code-server .."

screen -t httpServer 13 zsh -c 'deno run doc; cd ./docs; exec zsh'
# Prefills the prompt. The original stuff string has no trailing ^M (Enter).
stuff "http-server ."

select 0

# create layouts

layout new default
select denoUtils

layout new test
select test
split -h
resize 60%
focus
select lint

layout new server
select server
split -v
focus right
select plantuml

layout select default

# key bindings

# bindkey -k k1 layout select 0
# bindkey -k k2 layout select 1
# bindkey -k k3 layout select 2

# sets a screen session for the current project
sessionname denoUtils
